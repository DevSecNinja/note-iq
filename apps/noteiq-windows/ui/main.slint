import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, TextEdit } from "std-widgets.slint";
export { Palette }

/// One row of the meeting list. Row 0 is always "No meeting".
export struct MeetingRow {
    // The accessible name, for example `Design review · 04 Nov · 09:30–10:00`.
    label: string,
    time: string,
    title: string,
    details: string,
    now: bool,
    past: bool,
}

// Glyphs from Segoe Fluent Icons, which shares these code points with Segoe MDL2 Assets.
global Icons {
    out property <string> add: "\u{E710}";
    out property <string> open: "\u{E8A7}";
    out property <string> settings: "\u{E713}";
    out property <string> refresh: "\u{E72C}";
    out property <string> calendar: "\u{E787}";
    out property <string> chevron: "\u{E70D}";
    out property <string> folder: "\u{E8B7}";
    out property <string> edit: "\u{E70F}";
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> tip;
    in property <string> icon-font;
    in property <bool> checked;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: root.checked ? #dbe4fb : touch.has-hover ? #e7e9ee : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.glyph;
        font-family: root.icon-font;
        font-size: 16px;
        color: root.checked ? #1d4ed8 : #383b43;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: #1d4ed8;
    }

    Tooltip {
        text: @markdown("\{root.tip}");
    }
}

component LinkButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    min-width: label.preferred-width;

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    label := Text {
        text: root.text;
        color: #1d4ed8;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        accessible-role: none;
    }

    if focus.has-focus: Rectangle {
        border-radius: 3px;
        border-width: 1px;
        border-color: #1d4ed8;
    }
}

// Takes keyboard focus while highlighted, so screen readers follow the arrow keys. Keys it
// does not handle go to the list, which moves the highlight and chooses rows.
component MeetingListItem inherits FocusScope {
    in property <MeetingRow> entry;
    // The meeting attached to the note.
    in property <bool> selected;
    // The row Enter would choose.
    in property <bool> highlighted;
    in property <int> index;
    in property <int> count;
    callback clicked();
    callback focus-changed(bool);

    focus-on-click: false;
    focus-on-tab-navigation: false;
    accessible-role: list-item;
    accessible-label: root.entry.label;
    accessible-description: root.entry.details;
    accessible-item-selected: root.highlighted;
    accessible-item-index: root.index;
    accessible-item-count: root.count;
    accessible-action-default => { root.clicked(); }

    changed highlighted => {
        if root.highlighted {
            root.focus();
        }
    }
    focus-changed-event => { root.focus-changed(root.has-focus); }

    Rectangle {
        border-radius: 6px;
        background: root.selected ? #e8eefc : (root.highlighted || touch.has-hover) ? #f1f3f6 : #ffffff;
        border-width: root.highlighted && root.has-focus ? 1px : 0px;
        border-color: #1d4ed8;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;

        Text {
            width: 52px;
            text: root.entry.time;
            color: #5f6470;
            font-size: 13px;
            vertical-alignment: center;
            accessible-role: none;
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: root.entry.title;
                color: root.entry.past ? #5f6470 : #20232a;
                font-size: 14px;
                overflow: elide;
                min-width: 0px;
                accessible-role: none;
            }

            if root.entry.now || root.entry.details != "": HorizontalLayout {
                if root.entry.now: Text {
                    text: "Now";
                    color: #166534;
                    font-size: 12px;
                    font-weight: 600;
                    accessible-role: none;
                }
                Text {
                    text: root.entry.now && root.entry.details != "" ? " · " + root.entry.details : root.entry.details;
                    color: #5f6470;
                    font-size: 12px;
                    overflow: elide;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    accessible-role: none;
                }
            }
        }
    }
}

/// The meeting list: a picker showing the chosen meeting that opens two-line rows with the
/// time, title, and details, followed by Refresh meetings.
component MeetingPicker inherits Rectangle {
    in property <[MeetingRow]> rows;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    in property <bool> checking;
    in property <bool> refresh-enabled: true;
    in property <string> icon-font;
    // The list can be wider and taller than the picker itself.
    in property <length> popup-width: root.width;
    in property <length> popup-max-height: 400px;
    callback chosen(int);
    callback refresh-requested();

    // Changes only when the meetings or their order change, not when their details do.
    in property <int> list-version;

    property <MeetingRow> current: root.rows[root.current-index];
    property <bool> open;
    // The keyboard position in the open list; rows.length is Refresh meetings, and -1 means
    // nothing is highlighted because the meetings changed under it.
    property <int> highlight: -1;
    property <length> list-padding: 4px;
    property <length> first-row-height: 36px;
    property <length> row-height: 52px;
    property <length> separator-height: 9px;
    property <length> refresh-height: 40px;
    property <length> rows-height: 2 * root.list-padding + root.first-row-height + Math.max(0, root.rows.length - 1) * root.row-height;
    // Refresh meetings stays pinned below the rows, so it never scrolls out of view.
    property <length> footer-height: root.separator-height + root.refresh-height + root.list-padding;

    height: 34px;
    min-width: 120px;
    forward-focus: focus;
    horizontal-stretch: 1;
    border-radius: 6px;
    border-width: 1px;
    border-color: focus.has-focus || root.open ? #1d4ed8 : #c9ccd3;
    background: #ffffff;
    opacity: root.enabled ? 1 : 0.6;

    accessible-role: combobox;
    accessible-label: "Meeting";
    accessible-value: root.current.label;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-expand => { root.show-list(); }

    function show-list() {
        if root.enabled {
            // Setting the highlight after showing the list moves focus to that row.
            root.highlight = -1;
            popup.show();
            root.highlight = root.current-index;
        }
    }

    function choose(index: int) {
        root.current-index = index;
        popup.close();
        root.chosen(index);
    }

    function row-top(index: int) -> length {
        index <= 0 ? 0px : root.first-row-height + (index - 1) * root.row-height
    }

    function row-bottom(index: int) -> length {
        root.row-top(index) + (index <= 0 ? root.first-row-height : root.row-height)
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.show-list();
                return accept;
            }
            reject
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            root.show-list();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: Icons.calendar;
            font-family: root.icon-font;
            font-size: 14px;
            color: #5f6470;
            vertical-alignment: center;
            accessible-role: none;
        }

        if root.checking && root.current-index == 0: Text {
            text: "Checking your calendar…";
            color: #5f6470;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
        if !(root.checking && root.current-index == 0): Text {
            text: root.current.title;
            color: root.current-index == 0 ? #5f6470 : #20232a;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
            accessible-role: none;
        }

        if root.current.now: VerticalLayout {
            alignment: center;
            Rectangle {
                background: #dcfce7;
                border-radius: 9px;
                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    padding-top: 1px;
                    padding-bottom: 1px;
                    Text {
                        text: "Now";
                        color: #166534;
                        font-size: 11px;
                        font-weight: 600;
                        accessible-role: none;
                    }
                }
            }
        }

        Text {
            text: Icons.chevron;
            font-family: root.icon-font;
            font-size: 10px;
            color: #5f6470;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.popup-width;
        height: Math.min(root.rows-height + root.footer-height, root.popup-max-height);
        close-policy: close-on-click-outside;
        forward-focus: list-focus;

        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #c9ccd3;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #20232a33;
        }

        list-focus := FocusScope {
            // A reordered list must not let Enter choose whichever meeting moved under the
            // highlight.
            property <int> version: root.list-version;
            property <int> watched-highlight: root.highlight;

            changed version => {
                root.highlight = -1;
                self.focus();
            }
            // Keeps the highlighted meeting in view, including when the list opens.
            changed watched-highlight => {
                if root.highlight >= 0 && root.highlight < root.rows.length {
                    if root.row-top(root.highlight) < -list.content-y {
                        list.content-y = -root.row-top(root.highlight);
                    } else if root.row-bottom(root.highlight) + 2 * root.list-padding > list.visible-height - list.content-y {
                        list.content-y = list.visible-height - root.row-bottom(root.highlight) - 2 * root.list-padding;
                    }
                }
            }
            focus-changed-event => {
                root.open = self.has-focus;
            }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    popup.close();
                    return accept;
                }
                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                    if root.highlight < 0 {
                        root.highlight = root.current-index;
                    } else {
                        root.highlight = event.text == Key.DownArrow ? Math.min(root.highlight + 1, root.rows.length) : Math.max(root.highlight - 1, 0);
                    }
                    return accept;
                }
                if event.text == Key.Return || event.text == " " {
                    if root.highlight >= 0 && root.highlight < root.rows.length {
                        root.choose(root.highlight);
                    } else if root.highlight == root.rows.length && root.refresh-enabled {
                        root.refresh-requested();
                    }
                    return accept;
                }
                reject
            }

            VerticalLayout {
                list := ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: root.list-padding;
                        alignment: start;

                        for row[index] in root.rows: MeetingListItem {
                            height: index == 0 ? root.first-row-height : root.row-height;
                            entry: row;
                            index: index;
                            count: root.rows.length;
                            selected: index == root.current-index;
                            highlighted: index == root.highlight;
                            clicked => { root.choose(index); }
                            focus-changed(focused) => { root.open = focused; }
                        }
                    }
                }

                VerticalLayout {
                    padding-left: root.list-padding;
                    padding-right: root.list-padding;
                    padding-bottom: root.list-padding;

                    Rectangle {
                        height: root.separator-height;
                        Rectangle {
                            y: 4px;
                            height: 1px;
                            border-width: 1px;
                            border-color: #e6e8ed;
                        }
                    }

                    refresh-item := FocusScope {
                        property <bool> highlighted: root.highlight == root.rows.length;

                        height: root.refresh-height;
                        focus-on-click: false;
                        focus-on-tab-navigation: false;
                        changed highlighted => {
                            if self.highlighted {
                                self.focus();
                            }
                        }
                        focus-changed-event => { root.open = self.has-focus; }
                        accessible-role: button;
                        accessible-label: "Refresh meetings";
                        accessible-enabled: root.refresh-enabled;
                        accessible-action-default => {
                            if root.refresh-enabled {
                                root.refresh-requested();
                            }
                        }

                        Rectangle {
                            border-radius: 6px;
                            background: root.refresh-enabled && (refresh-touch.has-hover || refresh-item.highlighted) ? #f1f3f6 : #ffffff;
                            border-width: refresh-item.highlighted && refresh-item.has-focus ? 1px : 0px;
                            border-color: #1d4ed8;
                        }

                        refresh-touch := TouchArea {
                            enabled: root.refresh-enabled;
                            clicked => { root.refresh-requested(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;

                            Text {
                                width: 52px;
                                text: Icons.refresh;
                                font-family: root.icon-font;
                                font-size: 15px;
                                color: root.refresh-enabled ? #1d4ed8 : #5f6470;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            Text {
                                text: root.refresh-enabled ? "Refresh meetings" : "Checking your calendar…";
                                color: root.refresh-enabled ? #1d4ed8 : #5f6470;
                                font-size: 13px;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "NoteIQ";
    out property <image> app-icon: @image-url("../assets/noteiq.svg");
    icon: root.app-icon;
    min-width: 640px;
    min-height: 540px;
    preferred-width: 760px;
    preferred-height: 640px;
    background: #f5f6f8;
    forward-focus: note-editor;

    init => {
        // The capture surfaces are light even when Windows uses a dark theme.
        Palette.color-scheme = ColorScheme.light;
    }

    in-out property <string> note-text;
    in-out property <string> status-text;
    // Shows the status in red, for problems only.
    in-out property <bool> status-error;
    // Problems only: an empty hint takes no space.
    in-out property <string> meeting-hint;
    in-out property <bool> meeting-checking: true;
    in-out property <string> destination-label;
    // Row 0 is always "No meeting"; the others are meetings, most relevant first.
    in-out property <[MeetingRow]> meeting-rows: [{ label: "No meeting", title: "No meeting" }];
    in-out property <int> meeting-index: 0;
    // Bumped when the listed meetings or their order change.
    in-out property <int> meeting-list-version: 0;
    in-out property <bool> meeting-refresh-enabled: true;
    in-out property <bool> meeting-change-confirmation-visible: false;
    in-out property <bool> saved: false;
    in-out property <bool> has-note: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> auto-connect: true;
    in-out property <bool> meeting-reminders: true;
    in-out property <string> hotkey-text: "Win+Shift+N";
    in-out property <string> hotkey-error;
    in-out property <bool> hotkey-enabled: true;
    in-out property <string> note-filename-text: "{date}_{time}_{title}";
    in-out property <string> note-filename-preview;
    in-out property <string> note-filename-error;
    // Meeting templates: built-ins first, then the user's. `template-ids` parallels the names.
    in-out property <bool> templates-enabled: false;
    in-out property <[string]> template-names: ["General meeting"];
    in-out property <[string]> template-ids: ["general"];
    in-out property <int> default-template-index: 0;
    // The template offered for the open note.
    in-out property <int> note-template-index: 0;
    // The template shown in the Settings editor.
    in-out property <int> edit-template-index: 0;
    // The id of the template in the editor, which Save and Delete act on; empty for a new one.
    in-out property <string> edit-template-id;
    in-out property <string> template-name-text;
    in-out property <string> template-body-text;
    // False for built-in templates, which are read-only.
    in-out property <bool> template-editable: false;
    // The editor holds a template that has not been saved yet.
    in-out property <bool> template-is-new: false;
    in-out property <string> template-message;
    in-out property <bool> template-message-error: false;
    in-out property <bool> destination-error: false;
    // Windows 10 has the same glyphs in Segoe MDL2 Assets.
    in-out property <string> icon-font: "Segoe Fluent Icons";
    // On-device AI Tidy up. `tidy-available` is true only when the setting is on and Windows
    // can run the model.
    in-out property <bool> tidy-setting: false;
    in-out property <bool> tidy-available: false;
    in-out property <string> tidy-availability-text;
    in-out property <bool> tidy-running: false;
    in-out property <bool> tidy-preview-visible: false;
    in-out property <styled-text> tidy-diff;
    in-out property <[string]> tidy-warnings;
    in-out property <bool> tidy-undo-available: false;
    in-out property <string> tidy-undo-label: "Undo tidy-up";
    // Ctrl+Z restores the original note until the next edit.
    in-out property <bool> tidy-undo-armed: false;
    property <int> meeting-change-focus-index: 0;

    changed meeting-change-confirmation-visible => {
        if meeting-change-confirmation-visible {
            meeting-change-focus-index = 0;
            meeting-change-dialog.focus();
        } else {
            meeting-picker.focus();
        }
    }

    callback body-changed(string);
    callback save-requested();
    callback open-requested();
    callback meeting-refresh-requested();
    // Only user choices in the picker call this; setting meeting-index from code does not.
    callback meeting-chosen(int);
    callback meeting-change-confirmed(int);
    callback meeting-change-cancelled();
    callback settings-requested(bool);
    callback destination-requested();
    callback auto-connect-changed(bool);
    callback meeting-reminders-changed(bool);
    callback hotkey-changed(string);
    callback hotkey-enabled-changed(bool);
    callback note-filename-edited(string);
    callback note-filename-changed(string);
    callback templates-enabled-changed(bool);
    callback default-template-chosen(int);
    callback note-template-insert-requested(int);
    callback template-edit-chosen(int);
    // True starts from a copy of the template in the editor; false starts blank.
    callback template-new-requested(bool);
    callback template-save-requested(string, string);
    callback template-delete-requested();
    callback new-note-requested();
    callback tray-action-requested(int);
    callback tidy-requested();
    callback tidy-cancel-requested();
    callback tidy-apply-requested();
    callback tidy-discard-requested();
    callback tidy-undo-requested();
    callback tidy-setting-changed(bool);

    changed tidy-preview-visible => {
        if tidy-preview-visible {
            tidy-apply-button.focus();
        } else {
            note-editor.focus();
        }
    }

    // Applies pending settings; Settings stays open while a value is rejected.
    function close-settings() {
        root.hotkey-changed(root.hotkey-text);
        root.note-filename-changed(root.note-filename-text);
        if root.hotkey-error == "" && root.note-filename-error == "" {
            root.settings-visible = false;
            root.settings-requested(false);
            note-editor.focus();
        }
    }

    FocusScope {
        forward-focus: note-editor;

        // Runs before the editor sees the key: the editor's own undo history cannot reach the
        // text from before a tidy-up. Only plain Ctrl+Z in the note editor; Ctrl+Shift+Z redoes.
        capture-key-pressed(event) => {
            if root.tidy-undo-armed && note-editor.has-focus && event.modifiers.control
                && !event.modifiers.shift && !event.modifiers.alt
                && (event.text == "z" || event.text == "Z") {
                root.tidy-undo-requested();
                return accept;
            }
            reject
        }

        key-pressed(event) => {
            if root.meeting-change-confirmation-visible {
                accept
            }
            if root.tidy-preview-visible && event.text == Key.Escape {
                root.tidy-discard-requested();
                accept
            }
            if event.modifiers.control && (event.text == "s" || event.text == "S") {
                root.save-requested();
                accept
            }
            if event.modifiers.control && (event.text == "n" || event.text == "N") {
                root.new-note-requested();
                accept
            }
            reject
        }

        VerticalLayout {
            padding: 16px;
            padding-bottom: 12px;
            spacing: 10px;

            toolbar := HorizontalLayout {
                spacing: 6px;

                meeting-picker := MeetingPicker {
                    rows: root.meeting-rows;
                    current-index <=> root.meeting-index;
                    // Settings never changes the meeting.
                    enabled: !root.settings-visible;
                    checking: root.meeting-checking;
                    refresh-enabled: root.meeting-refresh-enabled;
                    list-version: root.meeting-list-version;
                    icon-font: root.icon-font;
                    popup-width: toolbar.width;
                    popup-max-height: root.height - 80px;
                    chosen(index) => { root.meeting-chosen(index); }
                    refresh-requested => { root.meeting-refresh-requested(); }
                }

                VerticalLayout {
                    alignment: center;
                    padding-left: 2px;
                    padding-right: 2px;
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        border-width: 1px;
                        border-color: #d5d8de;
                    }
                }

                IconButton {
                    glyph: Icons.add;
                    label: "New note";
                    tip: "New note (Ctrl+N)";
                    icon-font: root.icon-font;
                    clicked => { root.new-note-requested(); }
                }
                if root.has-note: IconButton {
                    glyph: Icons.open;
                    label: "Open note";
                    tip: "Open note";
                    icon-font: root.icon-font;
                    clicked => { root.open-requested(); }
                }
                if root.tidy-available && !root.settings-visible: IconButton {
                    glyph: Icons.edit;
                    label: "Tidy up";
                    tip: "Tidy up with on-device AI. You review the changes first.";
                    icon-font: root.icon-font;
                    checked: root.tidy-running || root.tidy-preview-visible;
                    clicked => { root.tidy-requested(); }
                }
                IconButton {
                    glyph: Icons.settings;
                    label: "Settings";
                    tip: "Settings";
                    icon-font: root.icon-font;
                    checked: root.settings-visible;
                    clicked => {
                        if root.settings-visible {
                            root.close-settings();
                        } else {
                            root.settings-visible = true;
                            root.settings-requested(true);
                        }
                    }
                }
            }

            if root.meeting-hint != "": Rectangle {
                background: #fef3c7;
                border-radius: 6px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    Text {
                        text: root.meeting-hint;
                        color: #92400e;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            if root.tidy-running: Rectangle {
                background: #e0e7ff;
                border-radius: 6px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    Text {
                        text: "Tidying up on this PC with on-device AI… Your note stays as it is until you review the changes.";
                        color: #1e3a8a;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    LinkButton {
                        text: "Cancel";
                        clicked => { root.tidy-cancel-requested(); }
                    }
                }
            }

            Rectangle {
                min-width: 0px;
                min-height: 0px;
                vertical-stretch: 1;

                Rectangle {
                    visible: !root.settings-visible && !root.tidy-preview-visible;
                    VerticalLayout {
                        spacing: 8px;

                        note-editor := TextEdit {
                            min-height: 100px;
                            vertical-stretch: 1;
                            text <=> root.note-text;
                            // A note being tidied or reviewed must not change underneath.
                            read-only: root.tidy-running || root.tidy-preview-visible;
                            placeholder-text: "Start typing… notes save automatically.";
                            accessible-label: "Note contents";
                            font-family: "Segoe UI Variable";
                            font-size: 15px;
                            edited => { root.body-changed(self.text); }
                        }

                        HorizontalLayout {
                            min-height: 18px;
                            spacing: 8px;

                            // Wraps rather than truncating: it may be the only explanation of
                            // a failed save.
                            Text {
                                text: root.status-text;
                                color: root.status-error ? #b91c1c : #5f6470;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                wrap: word-wrap;
                            }
                            if root.destination-error: LinkButton {
                                text: "Choose folder";
                                clicked => { root.destination-requested(); }
                            }
                            if root.tidy-undo-available: LinkButton {
                                text: root.tidy-undo-label;
                                clicked => { root.tidy-undo-requested(); }
                            }
                            if root.templates-enabled: ComboBox {
                                width: 180px;
                                horizontal-stretch: 0;
                                model: root.template-names;
                                current-index <=> root.note-template-index;
                                accessible-label: "Note template";
                            }
                            if root.templates-enabled: Button {
                                text: "Insert template";
                                clicked => { root.note-template-insert-requested(root.note-template-index); }
                            }
                        }
                    }
                }

                // Shown instead of the editor until the user applies or discards the suggestion.
                // Not conditional, so the Apply button can take focus when it opens.
                Rectangle {
                    visible: root.tidy-preview-visible && !root.settings-visible;
                    background: #ffffff;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #c7d2fe;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Review the suggested tidy-up";
                            color: #20232a;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Made on this PC by the Windows on-device AI model. Removed text is struck through in red and added text is underlined in green. Your note doesn't change unless you apply it, and you can undo it afterwards.";
                            color: #5f6470;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            min-height: 80px;
                            content-width: self.visible-width;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 8px;
                                // Scrolls with the changes, so Apply and Discard stay in view.
                                if root.tidy-warnings.length > 0: Rectangle {
                                    background: #fef3c7;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 2px;
                                        Text {
                                            text: "Check before applying";
                                            color: #92400e;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                        for warning in root.tidy-warnings: Text {
                                            text: "• " + warning;
                                            color: #92400e;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                StyledText {
                                    text: root.tidy-diff;
                                    default-color: #20232a;
                                    default-font-size: 15px;
                                    default-font-family: "Segoe UI Variable";
                                    accessible-role: text;
                                    accessible-label: "Suggested changes";
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Button {
                                text: "Discard";
                                clicked => { root.tidy-discard-requested(); }
                            }
                            tidy-apply-button := Button {
                                text: "Apply";
                                primary: true;
                                clicked => { root.tidy-apply-requested(); }
                            }
                        }
                    }
                }

                if root.settings-visible: Rectangle {
                    background: #ffffff;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #e6e8ed;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        ScrollView {
                            content-width: self.width;

                            VerticalLayout {
                                spacing: 12px;
                                alignment: start;

                                Rectangle {
                                    background: #f7f7f9;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #ebecef;
                                    HorizontalLayout {
                                        padding: 8px;
                                        padding-left: 10px;
                                        spacing: 8px;
                                        Text {
                                            text: Icons.folder;
                                            font-family: root.icon-font;
                                            font-size: 15px;
                                            color: #383b43;
                                            vertical-alignment: center;
                                            accessible-role: none;
                                        }
                                        Text {
                                            text: root.destination-label;
                                            color: #383b43;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            overflow: elide;
                                        }
                                        Button {
                                            text: "Change";
                                            accessible-label: "Choose folder";
                                            clicked => { root.destination-requested(); }
                                        }
                                    }
                                }
                                CheckBox {
                                    text: "Connect to my current meeting automatically";
                                    checked: root.auto-connect;
                                    toggled => { root.auto-connect-changed(self.checked); }
                                }
                                CheckBox {
                                    text: "Suggest a note after untranscribed meetings";
                                    checked: root.meeting-reminders;
                                    toggled => {
                                        root.meeting-reminders = self.checked;
                                        root.meeting-reminders-changed(self.checked);
                                    }
                                }
                                CheckBox {
                                    text: "Enable the global capture shortcut";
                                    checked: root.hotkey-enabled;
                                    toggled => {
                                        root.hotkey-enabled = self.checked;
                                        root.hotkey-enabled-changed(self.checked);
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "Shortcut";
                                            color: #383b43;
                                            font-size: 13px;
                                            min-width: 96px;
                                            vertical-alignment: center;
                                        }
                                        LineEdit {
                                            text <=> root.hotkey-text;
                                            placeholder-text: "Win+Shift+N";
                                            accessible-label: "Capture shortcut";
                                            horizontal-stretch: 1;
                                            edited(text) => { root.hotkey-error = ""; }
                                            accepted(text) => { root.hotkey-changed(text); }
                                        }
                                    }
                                    if root.hotkey-error != "": Text {
                                        text: root.hotkey-error;
                                        color: #b91c1c;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "Filename";
                                            color: #383b43;
                                            font-size: 13px;
                                            min-width: 96px;
                                            vertical-alignment: center;
                                        }
                                        LineEdit {
                                            text <=> root.note-filename-text;
                                            placeholder-text: "{date}_{time}_{title}";
                                            accessible-label: "Note filename template";
                                            horizontal-stretch: 1;
                                            edited(text) => { root.note-filename-edited(text); }
                                            accepted(text) => { root.note-filename-changed(text); }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 106px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text {
                                                text: root.note-filename-error != "" ? root.note-filename-error : root.note-filename-preview;
                                                color: root.note-filename-error != "" ? #b91c1c : #5f6470;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: "Use {date}, {time}, and {title}. Applies to new notes.";
                                                color: #5f6470;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;
                                    // Keeps the wrapped description clear of the scroll bar.
                                    padding-right: 12px;

                                    Text {
                                        text: "On-device AI";
                                        color: #20232a;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    CheckBox {
                                        text: "Offer Tidy up for short notes";
                                        checked: root.tidy-setting;
                                        toggled => {
                                            root.tidy-setting = self.checked;
                                            root.tidy-setting-changed(self.checked);
                                        }
                                    }
                                    Text {
                                        text: "Rewrites a short note more concisely with the AI model built into Windows. It runs on this PC, so your note isn't sent anywhere. You review every change before it's applied, can undo it, and the note records \"ai_tidied: on-device\".";
                                        color: #5f6470;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: root.tidy-availability-text;
                                        color: #5f6470;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    Text {
                                        text: "Meeting templates";
                                        color: #20232a;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    CheckBox {
                                        text: "Insert a template into new meeting notes";
                                        checked: root.templates-enabled;
                                        toggled => {
                                            root.templates-enabled = self.checked;
                                            root.templates-enabled-changed(self.checked);
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "Default";
                                            color: #383b43;
                                            font-size: 13px;
                                            min-width: 96px;
                                            vertical-alignment: center;
                                        }
                                        ComboBox {
                                            model: root.template-names;
                                            current-index <=> root.default-template-index;
                                            accessible-label: "Default meeting template";
                                            selected(value) => { root.default-template-chosen(self.current-index); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "Edit";
                                            color: #383b43;
                                            font-size: 13px;
                                            min-width: 96px;
                                            vertical-alignment: center;
                                        }
                                        ComboBox {
                                            model: root.template-names;
                                            current-index <=> root.edit-template-index;
                                            accessible-label: "Template to edit";
                                            selected(value) => { root.template-edit-chosen(self.current-index); }
                                        }
                                        Button {
                                            text: "New";
                                            accessible-label: "New template";
                                            clicked => { root.template-new-requested(false); }
                                        }
                                        Button {
                                            text: "Duplicate";
                                            accessible-label: "Duplicate template";
                                            clicked => { root.template-new-requested(true); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "Name";
                                            color: #383b43;
                                            font-size: 13px;
                                            min-width: 96px;
                                            vertical-alignment: center;
                                        }
                                        LineEdit {
                                            text <=> root.template-name-text;
                                            read-only: !root.template-editable;
                                            placeholder-text: "Weekly sync";
                                            accessible-label: "Template name";
                                            horizontal-stretch: 1;
                                            edited(text) => { root.template-message = ""; }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 106px;
                                        TextEdit {
                                            height: 150px;
                                            text <=> root.template-body-text;
                                            read-only: !root.template-editable;
                                            accessible-label: "Template text";
                                            font-size: 13px;
                                            edited(text) => { root.template-message = ""; }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 106px;
                                        spacing: 8px;
                                        Text {
                                            text: root.template-message != "" ? root.template-message : root.template-editable ? "Use {title}, {date}, {time}, {organizer}, and {attendees}." : "Built-in templates are read-only. Duplicate one to make your own.";
                                            color: root.template-message-error ? #b91c1c : #5f6470;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            vertical-alignment: center;
                                        }
                                        if root.template-editable && !root.template-is-new: Button {
                                            text: "Delete";
                                            accessible-label: "Delete template";
                                            clicked => { root.template-delete-requested(); }
                                        }
                                        if root.template-editable: Button {
                                            text: "Save template";
                                            clicked => { root.template-save-requested(root.template-name-text, root.template-body-text); }
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "WorkIQ is provided by Scout; NoteIQ never installs it.";
                                color: #5f6470;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                wrap: word-wrap;
                            }
                            Button {
                                text: "Done";
                                primary: true;
                                clicked => { root.close-settings(); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.meeting-change-confirmation-visible: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #20232a;
        opacity: 0.38;
    }

    if root.meeting-change-confirmation-visible: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    meeting-change-dialog := FocusScope {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 460px;
        height: 190px;
        visible: root.meeting-change-confirmation-visible;
        enabled: root.meeting-change-confirmation-visible;
        forward-focus: cancel-button;

        property <bool> modal-visible: root.meeting-change-confirmation-visible;

        changed modal-visible => {
            if modal-visible {
                root.meeting-change-focus-index = 0;
                cancel-button.focus();
            }
        }

        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.meeting-change-cancelled();
                accept
            }
            reject
        }

        KeyBinding {
            keys: @keys(Tab);
            activated => {
                root.meeting-change-focus-index = Math.mod(root.meeting-change-focus-index + 1, 3);
                if root.meeting-change-focus-index == 0 {
                    cancel-button.focus();
                } else if root.meeting-change-focus-index == 1 {
                    change-meeting-button.focus();
                } else {
                    create-new-note-button.focus();
                }
            }
        }

        KeyBinding {
            keys: @keys(Shift + Tab);
            activated => {
                root.meeting-change-focus-index = Math.mod(root.meeting-change-focus-index + 2, 3);
                if root.meeting-change-focus-index == 0 {
                    cancel-button.focus();
                } else if root.meeting-change-focus-index == 1 {
                    change-meeting-button.focus();
                } else {
                    create-new-note-button.focus();
                }
            }
        }

        Rectangle {
            background: #ffffff;
            border-radius: 14px;
            border-width: 1px;
            border-color: #d7d9de;

            VerticalLayout {
                padding: 22px;
                spacing: 16px;

                Text {
                    text: "You are about to change the meeting for this note. Do you want to change it or create a new note?";
                    color: #20232a;
                    font-family: "Segoe UI Variable";
                    font-size: 15px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    cancel-button := Button {
                        text: "Cancel";
                        accessible-label: "Cancel";
                        clicked => { root.meeting-change-cancelled(); }
                    }
                    change-meeting-button := Button {
                        text: "Change meeting";
                        accessible-label: "Change meeting";
                        clicked => { root.meeting-change-confirmed(0); }
                    }
                    create-new-note-button := Button {
                        text: "Create new note";
                        accessible-label: "Create new note";
                        clicked => { root.meeting-change-confirmed(1); }
                    }
                }
            }
        }
    }
}
